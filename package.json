{
  "name": "holderpay",
  "version": "0.1.0",
  "private": true,
  "description": "Pay with a Nano token (TEACHER) or XNO, and get access nobody can grant without the payment.",
  "type": "module",
  "scripts": {
    "dev": "node --experimental-strip-types server/index.ts",
    "build:web": "node scripts/build-web.mjs",
    "keys": "node --experimental-strip-types scripts/keys.ts",
    "balance": "node --experimental-strip-types scripts/balance.ts",
    "launch": "node --experimental-strip-types scripts/launch-token.ts",
    "offers": "node --experimental-strip-types scripts/publish-offers.ts",
    "verify": "node --experimental-strip-types scripts/verify.ts",
    "await-funding": "node --experimental-strip-types scripts/await-funding.ts",
    "e2e": "node --experimental-strip-types scripts/e2e.ts",
    "test": "node --experimental-strip-types --test core/*.test.ts",
    "live-checkout": "node --experimental-strip-types scripts/live-checkout.ts",
    "smoke": "node --experimental-strip-types scripts/page-smoke.ts",
    "build:vercel": "node scripts/build-vercel.mjs",
    "check:deploy": "node scripts/check-deploy.mjs",
    "e2e:any": "node --experimental-strip-types scripts/e2e-anytoken.ts"
  },
  "dependencies": {
    "blakejs": "^1.2.1",
    "buffer": "^6.0.3",
    "nanocurrency": "^2.5.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
