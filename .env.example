# holderPay — environment. GITIGNORED. Never commit.
#
# STRICT RULE (owner): rpc.nano.to is the ONLY RPC service this app may use.
# No other node, proxy, or work service. The websocket is the same provider
# (wss://ws.nano.to). See core/rpc.ts.
NANO_RPC_URL=https://rpc.nano.to
NANO_WS_URL=wss://ws.nano.to
NANO_RPC_KEY=your-rpc-nano-to-key

PORT=8787

# --- PoC wallets (testnet-style burner keys on mainnet; micro amounts only) ---
CREATOR_SEED=
CREATOR_ADDRESS=

MERCHANT_SEED=
MERCHANT_ADDRESS=

BUYER_SEED=
BUYER_ADDRESS=

# Filled in by scripts/launch-token.ts once TEACHER is live on chain.
TEACHER_TOKEN_ID=
TEACHER_LAUNCH_HASH=

# --- holderPay discovery anchor ---
# Every holderPay wallet sends a one-time 1-raw "hello" here before its first
# op, so the verifier can derive its watch set from chain data alone. The
# private key is NOT load-bearing: an anchor can only ever add candidate
# accounts to a replay, never censor or forge one.
HOLDERPAY_ANCHOR_SEED=
HOLDERPAY_ANCHOR_ADDRESS=

# Comma/space separated extra accounts to include in the token replay.
WATCH_EXTRA=

# --- shop administration (NOT part of the trust model) ---
ADMIN_TOKEN=
HOLDERPAY_DEV=
HOLDERPAY_ALLOW_FORGE=
